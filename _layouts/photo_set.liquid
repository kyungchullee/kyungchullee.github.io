---
layout: default
title: "photos"
---


<h1>{{ page.title }}</h1>
<ul>
  {% for i in (1..page.photo_count) %}
    <img src="{{ site.baseurl }}/images/photos/{{ page.title }}-{{ i }}.jpg" alt="Photo {{ i }} from {{ page.title }}" width="80%" border="1">
  {% endfor %}
</ul>
<div>
  <a href="{{ site.baseurl }}/photos/">View All Photo Sets</a>
</div>